# Learning System 环境变量配置示例
# 复制此文件为 .env 并填入实际值

# ===== Claude API =====
ANTHROPIC_API_KEY=sk-ant-xxxxx
# 可选：使用代理
# ANTHROPIC_BASE_URL=http://127.0.0.1:15721

# ===== Memory MCP配置 =====
# Memory MCP会自动检测和下载嵌入模型（~90MB）
# 首次运行需要30-60秒

# 可选：指定数据目录
# CLV2_HOMUNCULUS_DIR=/path/to/data

# ===== 测试项目路径 =====
TEST_PROJECT_PATH=E:/Desktop/langchain-business-trip-management

# ===== 可选：其他LLM配置 =====
# OpenAI API (可选)
# OPENAI_API_KEY=sk-xxxxx

# 本地模型 (可选)
# LOCAL_MODEL_URL=http://localhost:11434
